#. Description of the plugin
#: tassyir-for-woocommerce.php
msgid "Send WooCommerce orders and products to Tassyir, with a cash-on-delivery order form. Every order is queued and retried until Tassyir confirms it."
msgstr "أرسل طلبات ومنتجات WooCommerce إلى Tassyir، مع نموذج طلب بالدفع عند الاستلام. كل طلب يُحفظ في قائمة انتظار ويُعاد إرساله حتى يؤكده Tassyir."

#. Author of the plugin
#: tassyir-for-woocommerce.php
msgid "Tassyir"
msgstr ""

