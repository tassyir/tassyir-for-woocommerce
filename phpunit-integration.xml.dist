<?xml version="1.0"?>
<!-- Integration tests (WordPress and WooCommerce test suite), run inside wp-env, see README.md. -->
<phpunit bootstrap="tests/bootstrap-integration.php" colors="true" cacheResult="false">
	<testsuites>
		<testsuite name="integration">
			<directory suffix="Test.php">tests/integration</directory>
		</testsuite>
	</testsuites>
</phpunit>
